{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/SecurityPipeline.hook.ts" }]
      },
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/SecurityPipeline.hook.ts" }]
      },
      {
        "matcher": "Edit",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/SecurityPipeline.hook.ts" }]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/SecurityPipeline.hook.ts" }]
      },
      {
        "matcher": "WebFetch",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/SecurityPipeline.hook.ts" }]
      },
      {
        "matcher": "WebSearch",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/SecurityPipeline.hook.ts" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/ContentScanner.hook.ts" }]
      },
      {
        "matcher": "WebSearch",
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/ContentScanner.hook.ts" }]
      }
    ]
  }
}
